      "html": "<label class=\"ds-field\">Email address<input class=\"ds-input\" type=\"email\" autocomplete=\"username\" placeholder=\"dev@codecity.ai\" required /></label>",
      "css": ".ds-field{display:grid;gap:10px;color:#d3d8dc;font:500 12px Manrope,sans-serif}.ds-input{height:54px;min-width:0;padding:0 16px;border:1px solid #626b74;border-radius:8px;background:#0e1319;color:#edf0ed;caret-color:#f8a087;font:14px Manrope,sans-serif;transition:border-color 180ms ease,background-color 180ms ease}.ds-input::placeholder{color:#939da7;opacity:1}.ds-input:hover{border-color:#89959f}.ds-input:focus{border-color:#a5b7c6;background:#121a22}.ds-input:focus-visible{outline:2px solid #d5e1e9;outline-offset:5px;}.ds-input:autofill{-webkit-text-fill-color:#edf0ed;box-shadow:0 0 0 100px #121a22 inset}@media(prefers-reduced-motion:reduce){.ds-input{transition:none}}"
