VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
TRACKING_HASH_SALT=server-only-random-value-at-least-16-characters
RATE_LIMIT_SALT=server-only-random-value-at-least-32-characters
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://codecity.ai,https://www.codecity.ai
MAILGUN_API_KEY=server-only-mailgun-api-key
# Mailgun's HTTP Webhook Signing Key is separate from MAILGUN_API_KEY.
MAILGUN_WEBHOOK_SIGNING_KEY=server-only-mailgun-http-signing-key
MAILGUN_DOMAIN=mg.your-domain.example
MAILGUN_FROM="Code City <notifications@mg.your-domain.example>"
MAILGUN_API_BASE=https://api.mailgun.net
# Supabase Edge Function secrets ONLY (never VITE_*).
# HTTPS origin of the owner-approved Trade City reporting backend.
TRADECITY_WEB_BACKEND_URL=https://your-existing-tradecity-backend.example
# Existing backend credential, retained on the server; proxy allows only three GET routes.
TRADECITY_WEB_READ_TOKEN=server-only-backend-token
