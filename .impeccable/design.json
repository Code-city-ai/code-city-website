  "components": [
    {
      "name": "Workspace action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Existing form submit action; preview is visual only.",
      "html": "<button class=\"ds-submit\" type=\"button\"><span>Enter the workspace</span><svg aria-hidden=\"true\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></button>",
      "css": ".ds-submit{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:56px;width:100%;padding:0 20px;border:0;border-radius:8px;background:#edf0ed;color:#10171d;font:700 13px Manrope,sans-serif;cursor:pointer;transition:background-color 180ms ease,transform 180ms ease}.ds-submit:hover:not(:disabled){background:#fff;transform:translateY(-2px)}.ds-submit:active:not(:disabled){transform:translateY(0)}.ds-submit:focus-visible{outline:2px solid #d5e1e9;outline-offset:5px;}.ds-submit:disabled{opacity:.55;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-submit{transition:none}}"
    },
    {
      "name": "Set or reset password",
      "kind": "button",
      "refersTo": "button-reset",
      "description": "One existing inline action for password setup and reset.",
      "html": "<button class=\"ds-reset\" type=\"button\">Set or reset password <svg aria-hidden=\"true\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 7h10v10M7 17 17 7\"/></svg></button>",
      "css": ".ds-reset{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:44px;padding:5px 0;border:0;background:transparent;color:#c4cbd1;font:12px Manrope,sans-serif;cursor:pointer;text-underline-offset:5px}.ds-reset:hover{color:#edf0ed;text-decoration:underline}.ds-reset:focus-visible{outline:2px solid #d5e1e9;outline-offset:5px;}.ds-reset:disabled{opacity:.55;cursor:not-allowed}"
    },
    {
      "name": "Password visibility",
      "kind": "button",
      "refersTo": "button-password",
      "description": "The existing 44px icon toggle, shown in its reveal state.",
      "html": "<button class=\"ds-password\" type=\"button\" aria-label=\"Show password\"><svg aria-hidden=\"true\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg></button>",
      "css": ".ds-password{display:grid;place-items:center;width:44px;height:44px;border:0;border-radius:4px;background:transparent;color:#a2aab2;cursor:pointer}.ds-password:hover{color:#edf0ed}.ds-password:focus-visible{outline:2px solid #d5e1e9;outline-offset:5px;}"
    },
    {
